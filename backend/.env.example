APP_ENV=development
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=10s
POSTGRES_DSN=postgres://real_city:real_city@postgres:5432/real_city?sslmode=disable
POSTGRES_DRIVER=postgres
WORKER_METRICS_ADDR=127.0.0.1:9091
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_SECRET=change-me-in-local-env
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
WS_PING_INTERVAL=25s
WS_WRITE_TIMEOUT=5s
SIMULATION_TICK_INTERVAL=1s
SIMULATION_EMBEDDED=true
SIMULATION_BATCH_SIZE=100
SIMULATION_WORKER_COUNT=1
SIMULATION_LOCK_TTL=15s
SIMULATION_CATCH_UP_LIMIT=10m
SIMULATION_SHUTDOWN_TIMEOUT=5s
STORAGE_PUBLIC_URL=http://localhost:8080/assets
LOG_LEVEL=debug

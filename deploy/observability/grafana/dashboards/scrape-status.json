{
  "uid": "real-city-scrape-status",
  "title": "Real City — сбор метрик",
  "description": "Доступность целей, HTTP и WebSocket. Отдельные p95 для карты.",
  "tags": ["real-city", "observability"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Доступность целей (up)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}} / {{instance}}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP запросы в секунду",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "expr": "sum by (status_class) (rate(real_city_http_requests_total{job=\"api\"}[5m]))", "legendFormat": "{{status_class}}" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Активные WebSocket соединения",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "expr": "real_city_ws_connections{job=\"api\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Потерянные WebSocket сообщения в секунду",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "expr": "sum(rate(real_city_ws_messages_dropped_total{job=\"api\"}[5m]))", "legendFormat": "drops" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Карта: p95 HTTP, секунды",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(real_city_http_request_duration_seconds_bucket{job=\"api\",route=~\"GET /api/v1/world/(viewport|chunks)\"}[5m])))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Карта: запросы в секунду",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "refId": "A", "expr": "sum by (route, status_class) (rate(real_city_http_requests_total{job=\"api\",route=~\"GET /api/v1/world/(viewport|chunks)\"}[5m]))", "legendFormat": "{{route}} {{status_class}}" }]
    }
  ]
}

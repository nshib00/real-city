{$DOMAIN} {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    header X-Frame-Options DENY
    header Permissions-Policy "camera=(), microphone=(), geolocation=()"
    @internal path /metrics /metrics/* /debug /debug/*
    handle @internal {
        respond 404
    }
    handle /api/* {
        request_body {
            max_size 1MB
        }
        reverse_proxy backend:8080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 20s
            }
        }
    }
    handle /health {
        reverse_proxy backend:8080
    }
    handle /ready {
        reverse_proxy backend:8080
    }
    handle /assets/* {
        root * /srv
        @versioned path /assets/*.js /assets/*.css
        header @versioned Cache-Control "public, max-age=31536000, immutable"
        @runtimeMedia path_regexp runtimeMedia ^/assets/.*\.(?:png|webp|glb|svg|mp3|json)$
        header @runtimeMedia Cache-Control "public, max-age=3600"
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

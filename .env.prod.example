# Скопируйте в локальный .env и заполните все пять значений перед запуском.
# Указывайте конкретные теги или digest; latest для выпуска не подходит.
BACKEND_IMAGE=
FRONTEND_IMAGE=
DOMAIN=
# Случайная строка не короче 32 символов. Не храните её в Git.
SESSION_SECRET=
# Случайная строка из букв и цифр: значение входит в PostgreSQL URI.
POSTGRES_PASSWORD=

# Сессии: access 15 минут, refresh 30 дней. CORS ограничен https://DOMAIN.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Необязательные ограничения. Значения справа совпадают с Compose по умолчанию.
# При увеличении worker/pool учитывайте доступную CPU/RAM и число экземпляров API.
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=10s
WS_PING_INTERVAL=25s
WS_WRITE_TIMEOUT=5s
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
SIMULATION_TICK_INTERVAL=1s
SIMULATION_WORKER_COUNT=1
SIMULATION_BATCH_SIZE=100
SIMULATION_SHUTDOWN_TIMEOUT=5s
